region      = "us-east-2"
environment = "dev"

vpc_name     = "boutique-dev-vpc"
vpc_cidr     = "10.1.0.0/16"
cluster_name = "boutique-dev-eks"

# Minimum 2 AZs for ALB & EKS control plane requirements
public_subnet_cidrs  = ["10.1.1.0/24", "10.1.2.0/24"]
private_subnet_cidrs = ["10.1.10.0/24", "10.1.20.0/24"]
availability_zones   = ["us-east-2a", "us-east-2b"]

# Authorized administrative CIDR blocks for EKS public API endpoint.
# DOCUMENTATION PLACEHOLDER ONLY: Replace with the operator's actual publicly routable
# egress IP or authorized public CIDR (e.g. ["203.0.113.50/32"]) before deployment.
# WARNING: Never use private VPC CIDRs (e.g. 10.1.0.0/16) as workstation access ranges,
# as this will block external internet access to the EKS public API endpoint.
admin_cidr_blocks = ["203.0.113.50/32"]


