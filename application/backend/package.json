{
  "name": "boutique-backend",
  "version": "1.0.0",
  "description": "Backend microservices for boutique application",
  "scripts": {
    "dev:services": "concurrently \"npm run dev:gateway\" \"npm run dev:auth\"",
    "dev:gateway": "cd services/gateway && npm run dev",
    "dev:auth": "cd services/auth && npm run dev",
    "build": "cd services/gateway && npm run build && cd ../auth && npm run build",
    "test": "node -e \"const fs=require('fs'); if(fs.existsSync('tests/auth-security.test.js')){ require('./tests/auth-security.test.js'); } else { console.log('Notice: Test suite is retained for local development and omitted from public releases.'); }\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "prom-client": "^15.1.0",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/pg": "^8.10.9",
    "typescript": "^5.2.2",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "concurrently": "^8.2.2"
  }
}