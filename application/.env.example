# ==============================================================================
# Boutique Microservices — Local Development Environment Template
# ==============================================================================
# Security Invariant:
#   - This template provides local development defaults for Docker Compose ONLY.
#   - In Kubernetes / Production: DO NOT commit or use .env files.
#     All production credentials (database passwords, JWT signing secret) are
#     sourced from AWS Secrets Manager ('boutique/database/credentials' and
#     'boutique/auth/jwt-secret') and synchronized to Kubernetes Secrets.
# ==============================================================================

# PostgreSQL Database Configuration (Local Compose Defaults)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Microservices Database URLs (Inside Docker Compose network)
AUTH_DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/auth_db

# Local Host Database URLs (For running services on local host directly)
LOCAL_AUTH_DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/auth_db

# JWT Configuration
# Required: Generate a secure local development secret using: openssl rand -base64 32
# In production: JWT_SECRET must be at least 32 characters and never use weak/placeholder values.
# Set an explicit random secret below before launching services (do not leave empty):
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Demo Authentication (Local development only; defaults to false; strictly rejected in production)
# To deliberately enable the demo login shortcut (customer@boutique.com / demo) for local dev, set to true:
ENABLE_DEMO_LOGIN=false

# Service Ports & URLs
GATEWAY_PORT=3001
AUTH_PORT=3002
FRONTEND_PORT=3000

# Frontend API URL
VITE_API_URL=http://localhost:3001/api

# Node Environment
NODE_ENV=development
