# ==============================================================================
# Autonomous AIOps Platform — Environment Configuration Template
# ==============================================================================
# Security & Authentication:
#   - In Kubernetes (EKS): AWS credentials are automatically supplied via
#     EKS Pod Identity (aws_eks_pod_identity_association.aiops_agent).
#   - In Local Development: Authenticate via AWS CLI ('aws sso login' or AWS profile).
#     Never store long-lived static AWS access keys (AWS_ACCESS_KEY_ID / SECRET) in .env files.
# ==============================================================================

# AWS Configuration
# AWS_PROFILE=default
AWS_REGION=us-east-2
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=TSTALIASID

# Queue & Persistence Backend Configuration
# Options: 'memory' (local test) or 'sqs' / 'dynamodb' (AWS production)
AIOPS_QUEUE_BACKEND=memory
AIOPS_PERSISTENCE_BACKEND=memory

# SQS Queue Configuration (when AIOPS_QUEUE_BACKEND=sqs)
AIOPS_SQS_QUEUE_NAME=boutique-aiops-alert-queue.fifo
AIOPS_SQS_DLQ_NAME=boutique-aiops-alert-dlq.fifo
# AIOPS_SQS_QUEUE_URL=
# AIOPS_SQS_DLQ_URL=

# DynamoDB Table Configuration (when AIOPS_PERSISTENCE_BACKEND=dynamodb)
AIOPS_DYNAMODB_EPISODES_TABLE=boutique-aiops-episodes
AIOPS_DYNAMODB_RCA_TABLE=boutique-aiops-rca-reports
AIOPS_SQS_VISIBILITY_TIMEOUT=300

# Standby Safety Controls
AIOPS_BEDROCK_ENABLED=false
AIOPS_WEBHOOK_ENABLED=false

# Authentication Tokens (Sourced from AWS Secrets Manager in production)
# - AIOPS_WEBHOOK_BEARER_TOKEN: Synchronized from 'boutique/aiops/webhook-token'
# - AIOPS_GITHUB_TOKEN: Synchronized from 'boutique/aiops/github-token'
# AIOPS_WEBHOOK_BEARER_TOKEN=
# AIOPS_GITHUB_TOKEN=
